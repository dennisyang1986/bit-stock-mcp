# ===== bit.com / Matrixport API =====
BIT_BASE_URL=https://mapi.matrixport.com
BIT_ACCESS_KEY=
BIT_SECRET_KEY=
# v2 = X-Signature header scheme (current); v1 = signature in params (legacy).
# Try v1 only if selftest returns an authentication error.
BIT_AUTH_MODE=v2
BIT_TIMEOUT_MS=10000

# ===== MCP server =====
HOST=127.0.0.1
PORT=8790
MCP_PATH=/mcp
# REQUIRED. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# ===== Risk controls =====
# Start read-only. Flip to true only after testing.
TRADING_ENABLED=false
ALLOW_MARKET_ORDERS=false
ALLOW_OUTSIDE_RTH=true
MAX_ORDER_QTY=1000
MAX_ORDER_NOTIONAL_USD=10000
# Optional comma-separated list, e.g. AAPL.US,NVDA.US (empty = all symbols allowed).
SYMBOL_ALLOWLIST=
DEFAULT_REGION=US

# Optional. Defaults to ./logs
# LOG_DIR=/absolute/path/to/logs
